# Vite only loads .env.development for `vite dev` (mode "development") — a
# production `vite build` defaults to mode "production" and never reads this
# file, so these console test hooks stay out of shipped builds without
# depending on the implicit import.meta.env.DEV flag.

# Exposes window.__testCompleteLesson / window.__testCompletePath in the
# browser console for reaching milestone screens (region-complete,
# roadmap-complete) without hand-authoring lesson content for every path.
VITE_ENABLE_TEST_HOOKS=true
